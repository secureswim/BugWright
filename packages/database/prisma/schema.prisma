generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskState {
  QUEUED
  PREPARING
  RESEARCHING
  PLANNING
  REPRODUCING
  CODING
  TESTING
  RE_RESEARCHING
  RE_CODING
  REVIEWING
  REVISION_REQUESTED
  AWAITING_HUMAN_APPROVAL
  PUBLISHING
  COMPLETED
  NEEDS_ATTENTION
  FAILED
  REJECTED
}

model Task {
  id              String    @id @default(cuid())
  repositoryUrl   String
  repositoryOwner String
  repositoryName  String
  issueNumber     Int
  issueTitle      String?
  issueBody       String?   @db.Text
  baseBranch      String    @default("main")
  baseCommit      String?
  workspacePath   String?
  state           TaskState @default(QUEUED)

  // Optimistic concurrency. The worker's startup requeue, the resume endpoint
  // and a pg-boss retry can all target the same task; a compare-and-swap on
  // this column keeps two runs from sharing one workspace.
  version         Int       @default(0)
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  leaseGeneration Int       @default(0)
  heartbeatAt     DateTime?

  attempt          Int   @default(0)
  // Budgets. Raised from 3/2/20/50: a real repository spends cycles on things
  // that are not the model's fault - an unresolvable import, a runner that
  // collected nothing - and two revisions left no room to recover from one bad
  // attempt before the run was stopped.
  maxAttempts      Int   @default(5)
  revisionCycle    Int   @default(0)
  maxRevisions     Int   @default(4)
  maxAgentRuns     Int   @default(32)
  maxModelCalls    Int   @default(90)
  timeoutMs        Int   @default(1800000)
  delegationCycles Int   @default(0)
  modelCalls       Int   @default(0)
  costUsd          Float @default(0)

  currentAgent       String?
  executionMode      String    @default("MULTI_AGENT")
  demoMode           Boolean   @default(false)
  plan               String?   @db.Text
  managerPlan        Json?
  researchReport     Json?
  reproductionReport Json?
  patchProposal      Json?
  testReport         Json?
  reviewReport       Json?
  summary            String?   @db.Text
  diff               String?   @db.Text
  approvalHash       String?
  reviewArtifact     Json?
  reproductionProof  Json?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  pullRequestUrl     String?
  error              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  events              TaskEvent[]
  testRuns            TestRun[]
  approvals           Approval[]
  messages            AgentMessage[]
  agentRuns           AgentRun[]
  publicationAttempts PublicationAttempt[]

  @@index([state, createdAt])
}

model PublicationAttempt {
  id             String   @id @default(cuid())
  taskId         String
  artifactHash   String
  idempotencyKey String   @unique
  status         String
  branch         String
  commitSha      String?
  pullRequestUrl String?
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskEvent {
  id         BigInt   @id @default(autoincrement())
  taskId     String
  type       String
  title      String
  detail     String?  @db.Text
  tool       String?
  agentRole  String?
  status     String?
  durationMs Int?
  iteration  Int      @default(0)
  input      Json?
  output     Json?
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
}

model AgentMessage {
  id        String   @id @default(cuid())
  taskId    String
  fromRole  String
  toRole    String
  type      String
  payload   Json
  iteration Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model AgentRun {
  id          String  @id @default(cuid())
  taskId      String
  role        String
  objective   String?
  parentRunId String?
  status      String
  iteration   Int     @default(0)
  input       Json?
  output      Json?

  modelCalls   Int     @default(0)
  // Provider attempts that were retried rather than completing. Counted apart
  // from modelCalls so a rate limit does not inflate the efficiency metric.
  retries      Int     @default(0)
  model        String?
  toolCalls    Int     @default(0)
  toolsUsed    Json?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)
  // Peak request size across the whole conversation, including tool results.
  contextChars Int     @default(0)

  inputArtifactIds String[]  @default([])
  outputArtifactId String?
  error            String?   @db.Text
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
}

model TestRun {
  id           String   @id @default(cuid())
  taskId       String
  artifactHash String?
  kind         String?
  command      String
  exitCode     Int
  stdout       String   @db.Text
  stderr       String   @db.Text
  durationMs   Int
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Approval {
  id        String   @id @default(cuid())
  taskId    String
  hash      String
  decision  String
  note      String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
