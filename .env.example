DATABASE_URL=postgresql://bugwright:bugwright@localhost:5432/bugwright
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# --- Models -----------------------------------------------------------------
# Default provider for every role. Either "provider" or "provider:model".
#   gemini | anthropic | openai
BUGWRIGHT_MODEL=gemini

# Per-role overrides win over BUGWRIGHT_MODEL. Two uses worth knowing about:
#
#  1. Cost. The research fan-out runs up to three agents per task and does not
#     need a frontier model; coding and review do.
#  2. Review independence. Two instances of the same model share failure modes,
#     so a Reviewer on a different family is meaningfully less likely to be
#     blind to the mistakes the Coder just made. /metrics reports whether this
#     is actually configured.
#
# BUGWRIGHT_MODEL_RESEARCHER=gemini:gemini-3.5-flash-lite
# BUGWRIGHT_MODEL_REPRODUCER=gemini:gemini-3.8-flash
# BUGWRIGHT_MODEL_CODER=gemini:gemini-3.5-pro
# BUGWRIGHT_MODEL_REVIEWER=anthropic:claude-sonnet-4-20250514

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Deterministic replay ---------------------------------------------------
# Record every model exchange to a cassette, then replay it with no API key and
# no network. This is what lets CI exercise the orchestrator end to end.
#   BUGWRIGHT_RECORD=1   capture while running normally
#   BUGWRIGHT_REPLAY=1   serve recorded responses; an unrecorded request errors
# BUGWRIGHT_CASSETTE=evaluations/cassettes/default.json

# --- Runner -----------------------------------------------------------------
BUGWRIGHT_WORKSPACE_ROOT=./workspaces
BUGWRIGHT_RUNNER_IMAGE_NODE=bugwright-runner-node:latest
BUGWRIGHT_RUNNER_IMAGE_PYTHON=bugwright-runner-python:latest
BUGWRIGHT_PROJECT_ROOT=.
BUGWRIGHT_DOCKER_BIN=docker

# --- Publishing -------------------------------------------------------------
# Only needed to open draft pull requests. Never reaches any agent: the
# publisher is ordinary backend code behind the human approval gate, and MCP
# servers receive a per-server environment allowlist rather than this file.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
