{
  "name": "bugwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/mcp/*"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "compose:down": "docker compose down",
    "compose:up": "docker compose up -d postgres",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "demo": "node --require ./scripts/windows-user-shim.cjs --import tsx scripts/run-demo.ts",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"npm run dev -w @bugwright/api\" \"npm run dev -w @bugwright/worker\" \"npm run dev -w @bugwright/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke:mcp": "node --require ./scripts/windows-user-shim.cjs --import tsx scripts/smoke-mcp.ts",
    "test": "vitest run",
    "test:reliability": "node --require ./scripts/windows-user-shim.cjs --import tsx scripts/reliability/run-reliability.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
